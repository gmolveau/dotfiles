#!/usr/bin/env bash
set -o errexit
set -o pipefail
set -o nounset

# ffind = file-find
# list files in the current dir, interactively via fzf.

deps=0
for app in fd fzf bat; do
    ! command -v ${app} &> /dev/null && echo "$app is not installed" && deps=1
done
[[ $deps -ne 0 ]] && exit 1

query="${1-}"

fd --type f --hidden | fzf \
    --query "${query}" \
    --preview "bat --color=always --style=numbers {1}" \
    --bind "ctrl-c:execute(echo {1} | pbcopy)+abort" \
    --bind "ctrl-o:execute(open -R {1})" \
    --bind "ctrl-e:execute(ccc {1})" \
    --bind "ctrl-x:execute(ooo {1})" \
    --bind "ctrl-d:abort"
